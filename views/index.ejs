<%- include('layouts/header.ejs') %>

<style>
  :root { --primary: #FF6B35; --primary-dark: #E85D2C; --secondary: #FFB800; --bg: #050505; --text: #FFFFFF; --text-muted: #A0A0A0; --glass: rgba(255, 255, 255, 0.05); --border: rgba(255, 255, 255, 0.1); }
  body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); }
  .bg-animation { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  .gradient-orb { position: absolute; border-radius: 50%; filter: blur(60px); opacity: 0.3; animation: float 20s ease-in-out infinite; }
  .orb-1 { width: 450px; height: 450px; background: radial-gradient(circle, var(--primary), transparent); top: -150px; right: -150px; }
  .orb-2 { width: 375px; height: 375px; background: radial-gradient(circle, var(--secondary), transparent); bottom: -112px; left: -112px; animation-delay: 5s; }
  @keyframes float { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(22px, -22px); } }
  .container { position: relative; z-index: 1; max-width: 900px; padding: 18px; margin: 0 auto; }
  .logo { font-size: 24px; font-weight: 900; background: linear-gradient(135deg, var(--primary), var(--secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: -1px; margin-bottom: 60px; }
  .hero { text-align: center; margin-bottom: 45px; }
  .hero h1 { font-size: clamp(30px, 8vw, 54px); font-weight: 900; line-height: 1.1; margin-bottom: 15px; letter-spacing: -2px; }
  .gradient-text { background: linear-gradient(135deg, var(--primary), var(--secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero p { font-size: 13.5px; color: var(--text-muted); max-width: 412px; margin: 0 auto; }
  .search-card { max-width: 510px; margin: 0 auto 60px; background: var(--glass); border: 1px solid var(--border); border-radius: 18px; padding: 30px; backdrop-filter: blur(20px); }
  label { display: block; font-size: 10.5px; font-weight: 600; margin-bottom: 7.5px; }
  .search-card input:not([type=range]):not([type=checkbox]), .search-card select { width: 100%; padding: 10.5px 13.5px; background: rgba(255, 255, 255, 0.03) !important; border: 1px solid var(--border) !important; border-radius: 9px; color: var(--text) !important; font-size: 11.25px; outline: none; transition: all 0.3s; }
  .search-card input:not([type=range]):not([type=checkbox]):focus, .search-card select:focus { background: rgba(255, 255, 255, 0.05) !important; border-color: var(--primary) !important; box-shadow: 0 0 0 2.25px rgba(255, 107, 53, 0.1) !important; }
  .search-card select option { background: #1a1a1a; color: white; }
  .input-group { position: relative; margin-bottom: 6px; }
  .input-hint { font-size: 11.25px; color: var(--text-muted); margin-top: 4.5px; font-style: italic; }
  .gps-btn { position: absolute; right: 4.5px; top: 50%; transform: translateY(-50%); background: linear-gradient(135deg, var(--primary), var(--primary-dark)); border: none; width: 30px; height: 30px; border-radius: 7.5px; cursor: pointer; transition: transform 0.2s; }
  
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px; }
  
  .checkbox-group { display: flex; align-items: center; gap: 6px; margin-top: 9px; padding: 7.5px; background: rgba(255, 255, 255, 0.02); border-radius: 6px; }
  .checkbox-group input[type=checkbox] { width: 13.5px; height: 13.5px; cursor: pointer; accent-color: var(--primary); }
  .checkbox-group label { margin: 0; font-size: 9.75px; font-weight: 500; cursor: pointer; }
  
  .range-container { margin-top: 15px; }
  input[type=range] { width: 100%; accent-color: var(--primary); height: 4.5px; background: #333; border-radius: 3.75px; outline: none; }
  .range-value { text-align: right; color: var(--secondary); font-weight: bold; font-size: 0.675em; margin-top: 3.75px; }

  #map { width: 100%; height: 300px; border-radius: 15px; margin-bottom: 30px; border: 1px solid var(--border); }

  .submit-btn { width: 100%; padding: 12px; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); border: none; border-radius: 9px; color: white; font-size: 12px; font-weight: 700; cursor: pointer; transition: transform 0.2s; margin-top: 15px; }
  .submit-btn:hover { transform: translateY(-2px); }
  .results-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-bottom: 60px; }
  .place-card { background: var(--glass); border: 1px solid var(--border); border-radius: 15px; overflow: hidden; backdrop-filter: blur(20px); transition: transform 0.3s; }
  .place-card:hover { transform: translateY(-3px); }
  .place-image { width: 100%; height: 150px; object-fit: cover; }
  .place-content { padding: 15px; }
  .maps-btn { width: 100%; padding: 9px; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border); border-radius: 7.5px; color: var(--text); font-size: 10.5px; font-weight: 600; margin-top: 10.5px; text-decoration: none; display: block; text-align: center; transition: all 0.3s; }
  .maps-btn:hover { background: rgba(255, 255, 255, 0.1); border-color: var(--primary); }
  .price-row { display: flex; justify-content: space-between; padding: 7.5px 0; border-top: 1px solid var(--border); font-size: 10.5px; }
  .price-row.total { border-top: 2px solid var(--border); font-weight: 700; color: var(--secondary); font-size: 11.25px; margin-top: 4.5px; }
  .rating-badge { display: inline-block; padding: 3px 9px; background: rgba(255, 184, 0, 0.15); border: 1px solid rgba(255, 184, 0, 0.3); border-radius: 15px; font-size: 9.75px; font-weight: 600; color: var(--secondary); margin-bottom: 7.5px; }
  
  @media (max-width: 768px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<div class="bg-animation">
  <div class="gradient-orb orb-1"></div>
  <div class="gradient-orb orb-2"></div>
</div>

<div class="container">
  <div class="logo">FUGIDA</div>

  <section class="hero">
    <h1>Seu próximo rolê<br><span class="gradient-text">decidido em segundos</span></h1>
    <p>Encontre os melhores lugares para sair hoje, com custo total calculado e sugestões personalizadas</p>
  </section>

  <div class="search-card">
    <form action="/gerar-roteiro" method="POST" id="mainForm">
      <input type="hidden" name="latitude" id="latitude" value="<%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.latitude ? dadosBusca.latitude : '' %>">
      <input type="hidden" name="longitude" id="longitude" value="<%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.longitude ? dadosBusca.longitude : '' %>">
      <input type="hidden" name="excludedIds" id="excludedIds" value="<%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.excludedIds ? dadosBusca.excludedIds : '' %>">

      <div style="margin-bottom: 15px;">
        <label>Onde você está?</label>
        <div class="input-group">
          <input type="text" name="enderecoManual" id="enderecoManual" placeholder="Ex: Bairro, cidade, CEP ou ponto de referência." value="<%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.enderecoManual ? dadosBusca.enderecoManual : '' %>">
          <button type="button" class="gps-btn" id="btnGps" title="Usar minha localização atual">
            <svg width="13.5" height="13.5" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </button>
        </div>
        <div class="input-hint">Dica: informe um ponto de referência próximo para obter resultados mais precisos.</div>
      </div>

      <div class="form-row">
        <div>
          <label>Qual a vibe?</label>
          <select name="vibe">
            <option value="restaurante barzinho" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'restaurante barzinho' ? 'selected' : '' %>>Barzinho</option>
            <option value="restaurante romântico" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'restaurante romântico' ? 'selected' : '' %>>Date</option>
            <option value="hamburgueria pizza" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'hamburgueria pizza' ? 'selected' : '' %>>Larica</option>
            <option value="parque ar livre" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'parque ar livre' ? 'selected' : '' %>>Ar livre</option>
            <option value="balada festa" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'balada festa' ? 'selected' : '' %>>Festa</option>
            <option value="museu cultura cinema" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'museu cultura cinema' ? 'selected' : '' %>>Cultura</option>
          </select>
        </div>

        <div>
          <label>Orçamento (R$)</label>
          <input type="number" name="orcamento" placeholder="150" required value="<%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.orcamento ? dadosBusca.orcamento : '' %>">
          <div class="checkbox-group">
            <input type="checkbox" name="incluirUber" id="incluirUber" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.incluirUber ? 'checked' : '' %>>
            <label for="incluirUber">Incluir transporte por aplicativo no orçamento.</label>
          </div>
        </div>
      </div>

      <div class="range-container">
        <label>Raio de Busca: <span id="raioValor"><%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.raiokm ? dadosBusca.raiokm : '5' %></span> km</label>
        <input type="range" name="raiokm" id="raioInput" min="1" max="30" value="<%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.raiokm ? dadosBusca.raiokm : '5' %>">
      </div>

      <button type="submit" id="btnProcurar" class="submit-btn">Procurar</button>
    </form>
  </div>

  <% if (roteiros && roteiros.length > 0) { %>
    <div style="text-align: center; margin-bottom: 22.5px;">
      <h2 style="font-size: 24px; font-weight: 800; margin-bottom: 6px;">Melhores opções</h2>
      <p style="color: var(--text-muted); font-size: 11.25px;">Encontramos <%= roteiros.length %> lugar<%= roteiros.length > 1 ? 'es' : '' %> pra você</p>
    </div>

    <div id="map"></div>

    <div class="results-grid">
      <% roteiros.forEach(item => { %>
        <div class="place-card">
          <img 
            src="<%= item.foto %>" 
            alt="<%= item.nome %>" 
            class="place-image"
            onerror="this.onerror=null; this.src='https://maps.googleapis.com/maps/api/streetview?size=600x400&location=<%= item.lat %>,<%= item.lng %>&fov=80&source=outdoor&key=<%= mapKey %>';"
          >
          <div class="place-content">
            <span class="rating-badge">⭐ <%= item.rating %></span>
            <h3 style="font-size: 15px; font-weight: 700; margin: 7.5px 0;"><%= item.nome %></h3>
            <p style="color: var(--text-muted); font-size: 9.75px; margin-bottom: 12px;"><%= item.endereco %></p>
            
            <div class="price-row" style="color: #FFB800;">
              <span>Média de Gasto</span>
              <span><%= item.estimativa_preco %></span>
            </div>

            <% if (item.incluirUber) { %>
                <div class="price-row">
                <span>Uber (Ida e Volta)</span>
                <span>R$ <%= item.precoUber %></span>
                </div>
            <% } %>

            <div class="price-row total">
              <span><%= item.incluirUber ? 'Sobra do Orçamento' : 'Orçamento Disponível' %></span>
              <span>R$ <%= item.saldo %></span>
            </div>
            
            <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(item.nome + ' ' + item.endereco) %>" target="_blank" class="maps-btn">📍 Ver no Maps →</a>
          </div>
        </div>
      <% }) %>
    </div>

    <div style="text-align: center; margin-bottom: 45px;">
        <button id="btnOther" class="submit-btn" style="max-width: 300px; margin: 0 auto; background: linear-gradient(135deg, #333, #222);">
            Exibir novas sugestões
        </button>
    </div>
  <% } %>

  <% if (erro) { %>
    <div style="max-width: 450px; margin: 30px auto; padding: 15px; background: rgba(255, 107, 53, 0.1); border: 1px solid var(--primary); border-radius: 12px; text-align: center;">
      <strong style="color: var(--primary); font-size: 12px;">⚠️ Erro:</strong> 
      <p style="margin-top: 6px; color: var(--text); font-size: 11.25px;"><%= erro %></p>
    </div>
  <% } %>
</div>

<script>
const raioInput = document.getElementById('raioInput');
const raioValor = document.getElementById('raioValor');
raioInput.addEventListener('input', (e) => {
    raioValor.innerText = e.target.value;
});

const btnGps = document.getElementById('btnGps');
const inputEnd = document.getElementById('enderecoManual');
const latitude = document.getElementById('latitude');
const longitude = document.getElementById('longitude');

btnGps.onclick = () => {
  if (!navigator.geolocation) return alert('GPS não suportado no seu navegador');
  inputEnd.placeholder = 'Buscando sua localização...';
  inputEnd.disabled = true;
  navigator.geolocation.getCurrentPosition(pos => {
    latitude.value = pos.coords.latitude;
    longitude.value = pos.coords.longitude;
    inputEnd.value = '📍 Localização Atual (GPS Ativo)';
    inputEnd.readOnly = true;
    inputEnd.disabled = false;
    btnGps.style.background = 'linear-gradient(135deg, #10b981, #059669)';
  }, () => {
    alert('Não foi possível obter sua localização');
    inputEnd.placeholder = 'Ex: Orta Bar, Savassi, CEP 30140-071...';
    inputEnd.disabled = false;
  });
};

const btnProcurar = document.getElementById('btnProcurar');
btnProcurar.onclick = () => {
    document.getElementById('excludedIds').value = "";
};

const btnOther = document.getElementById('btnOther');
if(btnOther) {
    btnOther.onclick = () => {
        const form = document.getElementById('mainForm');
        const excludedInput = document.getElementById('excludedIds');
        const roteirosAtuais = <%- roteiros ? JSON.stringify(roteiros) : '[]' %>;
        const currentIds = roteirosAtuais.map(r => r.id);
        
        let existing = excludedInput.value ? excludedInput.value.split(',') : [];
        let updated = existing.concat(currentIds);
        
        excludedInput.value = updated.join(',');
        form.submit();
    }
}
</script>

<% if (roteiros && roteiros.length > 0 && mapKey) { %>
<script>
  async function initMap() {
    const locais = <%- JSON.stringify(roteiros) %>;
    
    if (!locais || locais.length === 0) return;

    const centerLat = parseFloat(locais[0].lat);
    const centerLng = parseFloat(locais[0].lng);
    
    const { Map } = await google.maps.importLibrary("maps");
    const { AdvancedMarkerElement, PinElement } = await google.maps.importLibrary("marker");

    const map = new Map(document.getElementById("map"), {
      zoom: 13,
      center: { lat: centerLat, lng: centerLng },
      mapId: "DEMO_MAP_ID", 
      mapTypeId: 'roadmap',
      styles: [
        { elementType: "geometry", stylers: [{ color: "#242f3e" }] },
        { elementType: "labels.text.stroke", stylers: [{ color: "#242f3e" }] },
        { elementType: "labels.text.fill", stylers: [{ color: "#746855" }] },
        { featureType: "administrative.locality", elementType: "labels.text.fill", stylers: [{ color: "#d59563" }] },
        { featureType: "poi", elementType: "labels.text.fill", stylers: [{ color: "#d59563" }] },
        { featureType: "poi.park", elementType: "geometry", stylers: [{ color: "#263c3f" }] },
        { featureType: "poi.park", elementType: "labels.text.fill", stylers: [{ color: "#6b9a76" }] },
        { featureType: "road", elementType: "geometry", stylers: [{ color: "#38414e" }] },
        { featureType: "road", elementType: "geometry.stroke", stylers: [{ color: "#212a37" }] },
        { featureType: "road", elementType: "labels.text.fill", stylers: [{ color: "#9ca5b3" }] },
        { featureType: "road.highway", elementType: "geometry", stylers: [{ color: "#746855" }] },
        { featureType: "road.highway", elementType: "geometry.stroke", stylers: [{ color: "#1f2835" }] },
        { featureType: "road.highway", elementType: "labels.text.fill", stylers: [{ color: "#f3d19c" }] },
        { featureType: "transit", elementType: "geometry", stylers: [{ color: "#2f3948" }] },
        { featureType: "transit.station", elementType: "labels.text.fill", stylers: [{ color: "#d59563" }] },
        { featureType: "water", elementType: "geometry", stylers: [{ color: "#17263c" }] },
        { featureType: "water", elementType: "labels.text.fill", stylers: [{ color: "#515c6d" }] },
        { featureType: "water", elementType: "labels.text.stroke", stylers: [{ color: "#17263c" }] }
      ]
    });

    locais.forEach((lugar, index) => {
      const pin = new PinElement({
        glyph: (index + 1).toString(),
        background: '#FF6B35',
        borderColor: '#E85D2C',
        glyphColor: 'white',
      });

      const marker = new AdvancedMarkerElement({
        map: map,
        position: { lat: parseFloat(lugar.lat), lng: parseFloat(lugar.lng) },
        title: lugar.nome,
        content: pin.element
      });

      const infowindow = new google.maps.InfoWindow({
        content: `<div style="color:black; padding:6px; max-width: 150px;">
                    <strong style="font-size: 10.5px;">${lugar.nome}</strong><br>
                    <span style="color: #FFB800; font-size: 9.75px;">⭐ ${lugar.rating}</span>
                  </div>`
      });

      marker.addListener("click", () => {
        infowindow.open(map, marker);
      });
    });
  }
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= mapKey %>&callback=initMap&loading=async&v=weekly" async defer></script>
<% } %>

<%- include('layouts/footer.ejs') %>