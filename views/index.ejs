<%- include('layouts/header.ejs') %>

<style>
  /* MANTENHA SEU CSS EXISTENTE AQUI */
  :root { --primary: #FF6B35; --primary-dark: #E85D2C; --secondary: #FFB800; --bg: #050505; --text: #FFFFFF; --text-muted: #A0A0A0; --glass: rgba(255, 255, 255, 0.05); --border: rgba(255, 255, 255, 0.1); }
  body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); }
  .bg-animation { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  .gradient-orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.3; animation: float 20s ease-in-out infinite; }
  .orb-1 { width: 600px; height: 600px; background: radial-gradient(circle, var(--primary), transparent); top: -200px; right: -200px; }
  .orb-2 { width: 500px; height: 500px; background: radial-gradient(circle, var(--secondary), transparent); bottom: -150px; left: -150px; animation-delay: 5s; }
  @keyframes float { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(30px, -30px); } }
  .container { position: relative; z-index: 1; max-width: 1200px; padding: 24px; margin: 0 auto; }
  .logo { font-size: 32px; font-weight: 900; background: linear-gradient(135deg, var(--primary), var(--secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: -1px; margin-bottom: 80px; }
  .hero { text-align: center; margin-bottom: 60px; }
  .hero h1 { font-size: clamp(40px, 8vw, 72px); font-weight: 900; line-height: 1.1; margin-bottom: 20px; letter-spacing: -2px; }
  .gradient-text { background: linear-gradient(135deg, var(--primary), var(--secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero p { font-size: 18px; color: var(--text-muted); max-width: 550px; margin: 0 auto; }
  .search-card { max-width: 680px; margin: 0 auto 80px; background: var(--glass); border: 1px solid var(--border); border-radius: 24px; padding: 40px; backdrop-filter: blur(20px); }
  label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 10px; }
  .search-card input:not([type=range]):not([type=checkbox]), .search-card select { width: 100%; padding: 14px 18px; background: rgba(255, 255, 255, 0.03) !important; border: 1px solid var(--border) !important; border-radius: 12px; color: var(--text) !important; font-size: 15px; outline: none; transition: all 0.3s; }
  .search-card input:not([type=range]):not([type=checkbox]):focus, .search-card select:focus { background: rgba(255, 255, 255, 0.05) !important; border-color: var(--primary) !important; box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.1) !important; }
  .search-card select option { background: #1a1a1a; color: white; }
  .input-group { position: relative; margin-bottom: 8px; }
  .input-hint { font-size: 15px; color: var(--text-muted); margin-top: 6px; font-style: italic; }
  .gps-btn { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); background: linear-gradient(135deg, var(--primary), var(--primary-dark)); border: none; width: 40px; height: 40px; border-radius: 10px; cursor: pointer; transition: transform 0.2s; }
  
  /* FORM ROW GRID */
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
  
  /* CHECKBOX UBER - MELHOR POSICIONAMENTO */
  .checkbox-group { display: flex; align-items: center; gap: 8px; margin-top: 12px; padding: 10px; background: rgba(255, 255, 255, 0.02); border-radius: 8px; }
  .checkbox-group input[type=checkbox] { width: 18px; height: 18px; cursor: pointer; accent-color: var(--primary); }
  .checkbox-group label { margin: 0; font-size: 13px; font-weight: 500; cursor: pointer; }
  
  /* ESTILOS DO SLIDER */
  .range-container { margin-top: 20px; }
  input[type=range] { width: 100%; accent-color: var(--primary); height: 6px; background: #333; border-radius: 5px; outline: none; }
  .range-value { text-align: right; color: var(--secondary); font-weight: bold; font-size: 0.9em; margin-top: 5px; }

  /* ESTILOS DO MAPA */
  #map { width: 100%; height: 400px; border-radius: 20px; margin-bottom: 40px; border: 1px solid var(--border); }

  .submit-btn { width: 100%; padding: 16px; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); border: none; border-radius: 12px; color: white; font-size: 16px; font-weight: 700; cursor: pointer; transition: transform 0.2s; margin-top: 20px; }
  .submit-btn:hover { transform: translateY(-2px); }
  .results-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-bottom: 80px; }
  .place-card { background: var(--glass); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; backdrop-filter: blur(20px); transition: transform 0.3s; }
  .place-card:hover { transform: translateY(-4px); }
  .place-image { width: 100%; height: 200px; object-fit: cover; }
  .place-content { padding: 20px; }
  .maps-btn { width: 100%; padding: 12px; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border); border-radius: 10px; color: var(--text); font-size: 14px; font-weight: 600; margin-top: 14px; text-decoration: none; display: block; text-align: center; transition: all 0.3s; }
  .maps-btn:hover { background: rgba(255, 255, 255, 0.1); border-color: var(--primary); }
  .price-row { display: flex; justify-content: space-between; padding: 10px 0; border-top: 1px solid var(--border); font-size: 14px; }
  .price-row.total { border-top: 2px solid var(--border); font-weight: 700; color: var(--secondary); font-size: 15px; margin-top: 6px; }
  .rating-badge { display: inline-block; padding: 4px 12px; background: rgba(255, 184, 0, 0.15); border: 1px solid rgba(255, 184, 0, 0.3); border-radius: 20px; font-size: 13px; font-weight: 600; color: var(--secondary); margin-bottom: 10px; }
  
  @media (max-width: 768px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<div class="bg-animation">
  <div class="gradient-orb orb-1"></div>
  <div class="gradient-orb orb-2"></div>
</div>

<div class="container">
  <div class="logo">Fugida</div>

  <section class="hero">
    <h1>Seu próximo rolê<br><span class="gradient-text">decidido em segundos</span></h1>
    <p>Encontre os melhores lugares para sair hoje, com custo total calculado e sugestões personalizadas</p>
  </section>

  <div class="search-card">
    <form action="/gerar-roteiro" method="POST" id="mainForm">
      <input type="hidden" name="latitude" id="latitude" value="">
      <input type="hidden" name="longitude" id="longitude" value="">
      <input type="hidden" name="excludedIds" id="excludedIds" value="<%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.excludedIds ? dadosBusca.excludedIds : '' %>">

      <div style="margin-bottom: 20px;">
        <label>Onde você está?</label>
        <div class="input-group">
          <input type="text" name="enderecoManual" id="enderecoManual" placeholder="Ex: Bairro, cidade, CEP ou ponto de referência." value="<%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.enderecoManual ? dadosBusca.enderecoManual : '' %>">
          <button type="button" class="gps-btn" id="btnGps" title="Usar minha localização atual">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </button>
        </div>
        <div class="input-hint">Dica: informe um ponto de referência próximo para obter resultados mais precisos.</div>
      </div>

      <div class="form-row">
        <div>
          <label>Qual a vibe?</label>
          <select name="vibe">
            <option value="restaurante barzinho" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'restaurante barzinho' ? 'selected' : '' %>>Barzinho</option>
            <option value="restaurante romântico" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'restaurante romântico' ? 'selected' : '' %>>Date</option>
            <option value="hamburgueria pizza" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'hamburgueria pizza' ? 'selected' : '' %>>Larica</option>
            <option value="parque ar livre" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'parque ar livre' ? 'selected' : '' %>>Ar livre</option>
            <option value="balada festa" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'balada festa' ? 'selected' : '' %>>Festa</option>
            <option value="museu cultura cinema" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.vibe === 'museu cultura cinema' ? 'selected' : '' %>>Cultura</option>
          </select>
        </div>

        <div>
          <label>Orçamento (R$)</label>
          <input type="number" name="orcamento" placeholder="150" required value="<%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.orcamento ? dadosBusca.orcamento : '' %>">
          <div class="checkbox-group">
            <input type="checkbox" name="incluirUber" id="incluirUber" <%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.incluirUber ? 'checked' : '' %>>
            <label for="incluirUber">Incluir transporte por aplicativo no orçamento.</label>
          </div>
        </div>
      </div>

      <div class="range-container">
        <label>Raio de Busca: <span id="raioValor">5</span> km</label>
        <input type="range" name="raiokm" id="raioInput" min="1" max="30" value="<%= typeof dadosBusca !== 'undefined' && dadosBusca && dadosBusca.raiokm ? dadosBusca.raiokm : '5' %>">
      </div>

      <button type="submit" class="submit-btn">Procurar</button>
    </form>
  </div>

  <% if (roteiros && roteiros.length > 0) { %>
    <div style="text-align: center; margin-bottom: 30px;">
      <h2 style="font-size: 32px; font-weight: 800; margin-bottom: 8px;">Melhores opções</h2>
      <p style="color: var(--text-muted);">Encontramos <%= roteiros.length %> lugar<%= roteiros.length > 1 ? 'es' : '' %> pra você</p>
    </div>

    <div id="map"></div>

    <div class="results-grid">
      <% roteiros.forEach(item => { %>
        <div class="place-card">
          <img src="<%= item.foto %>" alt="<%= item.nome %>" class="place-image">
          <div class="place-content">
            <span class="rating-badge">⭐ <%= item.rating %></span>
            <h3 style="font-size: 20px; font-weight: 700; margin: 10px 0;"><%= item.nome %></h3>
            <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;"><%= item.endereco %></p>
            
            <div class="price-row" style="color: #FFB800;">
              <span>Média de Gasto</span>
              <span><%= item.estimativa_preco %></span>
            </div>

            <% if (item.incluirUber) { %>
                <div class="price-row">
                <span>Uber (Ida e Volta)</span>
                <span>R$ <%= item.precoUber %></span>
                </div>
            <% } %>

            <div class="price-row total">
              <span><%= item.incluirUber ? 'Sobra do Orçamento' : 'Orçamento Disponível' %></span>
              <span>R$ <%= item.saldo %></span>
            </div>
            
            <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(item.nome + ' ' + item.endereco) %>" target="_blank" class="maps-btn">📍 Ver no Maps →</a>
          </div>
        </div>
      <% }) %>
    </div>

    <div style="text-align: center; margin-bottom: 60px;">
        <button id="btnOther" class="submit-btn" style="max-width: 400px; margin: 0 auto; background: linear-gradient(135deg, #333, #222);">
            🎲 Não gostei, manda outros!
        </button>
    </div>
  <% } %>

  <% if (erro) { %>
    <div style="max-width: 600px; margin: 40px auto; padding: 20px; background: rgba(255, 107, 53, 0.1); border: 1px solid var(--primary); border-radius: 16px; text-align: center;">
      <strong style="color: var(--primary);">⚠️ Erro:</strong> 
      <p style="margin-top: 8px; color: var(--text);"><%= erro %></p>
    </div>
  <% } %>
</div>

<script>
// --- LÓGICA DO SLIDER ---
const raioInput = document.getElementById('raioInput');
const raioValor = document.getElementById('raioValor');
raioInput.addEventListener('input', (e) => {
    raioValor.innerText = e.target.value;
});

// --- LÓGICA DO GPS ---
const btnGps = document.getElementById('btnGps');
const inputEnd = document.getElementById('enderecoManual');
const latitude = document.getElementById('latitude');
const longitude = document.getElementById('longitude');

btnGps.onclick = () => {
  if (!navigator.geolocation) return alert('GPS não suportado no seu navegador');
  inputEnd.placeholder = 'Buscando sua localização...';
  inputEnd.disabled = true;
  navigator.geolocation.getCurrentPosition(pos => {
    latitude.value = pos.coords.latitude;
    longitude.value = pos.coords.longitude;
    inputEnd.value = '📍 Localização Atual (GPS Ativo)';
    inputEnd.readOnly = true;
    inputEnd.disabled = false;
    btnGps.style.background = 'linear-gradient(135deg, #10b981, #059669)';
  }, () => {
    alert('Não foi possível obter sua localização');
    inputEnd.placeholder = 'Ex: Orta Bar, Savassi, CEP 30140-071...';
    inputEnd.disabled = false;
  });
};

// --- LÓGICA DO "MANDA OUTROS" ---
const btnOther = document.getElementById('btnOther');
if(btnOther) {
    btnOther.onclick = () => {
        const form = document.getElementById('mainForm');
        const excludedInput = document.getElementById('excludedIds');
        const currentIds = [<%= roteiros ? roteiros.map(r => "'" + r.id + "'").join(",") : "" %>];
        
        let existing = excludedInput.value ? excludedInput.value.split(',') : [];
        let updated = existing.concat(currentIds);
        
        excludedInput.value = updated.join(',');
        form.submit();
    }
}
</script>

<% if (roteiros && roteiros.length > 0 && mapKey) { %>
<script>
  function initMap() {
    const centerLat = <%= roteiros[0].lat %>;
    const centerLng = <%= roteiros[0].lng %>;
    
    const map = new google.maps.Map(document.getElementById("map"), {
      zoom: 13,
      center: { lat: centerLat, lng: centerLng },
      mapTypeId: 'roadmap',
      styles: [
        { elementType: "geometry", stylers: [{ color: "#242f3e" }] },
        { elementType: "labels.text.stroke", stylers: [{ color: "#242f3e" }] },
        { elementType: "labels.text.fill", stylers: [{ color: "#746855" }] },
        { featureType: "administrative.locality", elementType: "labels.text.fill", stylers: [{ color: "#d59563" }] },
        { featureType: "poi", elementType: "labels.text.fill", stylers: [{ color: "#d59563" }] },
        { featureType: "poi.park", elementType: "geometry", stylers: [{ color: "#263c3f" }] },
        { featureType: "poi.park", elementType: "labels.text.fill", stylers: [{ color: "#6b9a76" }] },
        { featureType: "road", elementType: "geometry", stylers: [{ color: "#38414e" }] },
        { featureType: "road", elementType: "geometry.stroke", stylers: [{ color: "#212a37" }] },
        { featureType: "road", elementType: "labels.text.fill", stylers: [{ color: "#9ca5b3" }] },
        { featureType: "road.highway", elementType: "geometry", stylers: [{ color: "#746855" }] },
        { featureType: "road.highway", elementType: "geometry.stroke", stylers: [{ color: "#1f2835" }] },
        { featureType: "road.highway", elementType: "labels.text.fill", stylers: [{ color: "#f3d19c" }] },
        { featureType: "transit", elementType: "geometry", stylers: [{ color: "#2f3948" }] },
        { featureType: "transit.station", elementType: "labels.text.fill", stylers: [{ color: "#d59563" }] },
        { featureType: "water", elementType: "geometry", stylers: [{ color: "#17263c" }] },
        { featureType: "water", elementType: "labels.text.fill", stylers: [{ color: "#515c6d" }] },
        { featureType: "water", elementType: "labels.text.stroke", stylers: [{ color: "#17263c" }] }
      ]
    });

    const locais = <%- JSON.stringify(roteiros) %>;

    locais.forEach((lugar, index) => {
      const marker = new google.maps.Marker({
        position: { lat: lugar.lat, lng: lugar.lng },
        map: map,
        title: lugar.nome,
        label: {
          text: (index + 1).toString(),
          color: 'white',
          fontWeight: 'bold'
        }
      });

      const infowindow = new google.maps.InfoWindow({
        content: `<div style="color:black; padding:8px; max-width: 200px;">
                    <strong style="font-size: 14px;">${lugar.nome}</strong><br>
                    <span style="color: #FFB800;">⭐ ${lugar.rating}</span>
                  </div>`
      });

      marker.addListener("click", () => {
        infowindow.open(map, marker);
      });
    });
  }
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= mapKey %>&callback=initMap&loading=async" async defer></script>
<% } %>

<%- include('layouts/footer.ejs') %>
